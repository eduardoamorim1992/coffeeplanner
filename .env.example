# ===== Supabase (já usados pelas funções de admin existentes) =====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Integração com o Outlook (Microsoft Graph) =====
# Client ID e Tenant ID NÃO são secretos (identificadores públicos).
MS_CLIENT_ID=d05ca323-5d2b-4be4-85d6-e6bb3589522a
MS_TENANT_ID=e2c7697c-ee69-4708-9955-53f7fbca5e49

# O segredo do cliente é SENSÍVEL — cole o "Valor" gerado no Azure (Certificados e segredos).
MS_CLIENT_SECRET=

# Precisa bater EXATAMENTE com o "URI de redirecionamento" cadastrado no Azure.
MS_REDIRECT_URI=https://coffeplanner.online/api/outlook/callback

# Endereço base do app (para onde o usuário volta após conectar).
APP_BASE_URL=https://coffeplanner.online

# Opcional: chave para assinar o "state" do OAuth.
# Se ficar vazio, o backend reaproveita a SUPABASE_SERVICE_ROLE_KEY automaticamente.
OUTLOOK_STATE_SECRET=
